# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# JWT signing key (HS256, base64-encoded, 256 bits minimum). Generate with:
#   openssl rand -base64 32
JWT_SECRET_KEY=

# Database connection (used by docker-compose / application.properties overrides)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
