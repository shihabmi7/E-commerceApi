# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
# docker compose reads .env automatically.

# JWT signing key (HS256, base64-encoded, 256 bits minimum). REQUIRED. Generate with:
#   openssl rand -base64 32
JWT_SECRET_KEY=

# Password for the Postgres container started by docker compose (optional; default: postgres)
POSTGRES_PASSWORD=postgres

# Only for running the app on your machine (IntelliJ / mvn spring-boot:run) against the compose database:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ecommerce
#   SPRING_DATASOURCE_USERNAME=postgres
#   SPRING_DATASOURCE_PASSWORD=postgres
#   SPRING_RABBITMQ_HOST=localhost
